{
    "name": "example/simple-data-objects-csv-benchmark",
    "description": "Laravel CSV import benchmark for simple-data-objects and spatie/laravel-data",
    "type": "project",
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "..",
            "options": { "symlink": true }
        }
    ],
    "require": {
        "php": "^8.4",
        "laravel/framework": "^12.0",
        "spatie/laravel-data": "^4.23",
        "std-out/simple-data-objects": "@dev"
    },
    "autoload": {
        "psr-4": { "App\\": "app/" }
    },
    "scripts": {
        "bench": "php artisan benchmark:all",
        "bench:all": "php artisan benchmark:all",
        "sample": "php artisan csv:sample storage/users.csv --rows=100000"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
